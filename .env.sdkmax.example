# SDKMAX local development template.
# Copy to .env and replace placeholders. Do not commit .env.

PORT=3000
FRONTEND_BASE_URL=http://localhost:8080
VITE_REACT_APP_SERVER_URL=http://localhost:3000

DEBUG=true
GIN_MODE=debug
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
MEMORY_CACHE_ENABLED=true

SQL_DSN=sdkmax:change_me@tcp(127.0.0.1:3306)/sdkmax_new_api?charset=utf8mb4&parseTime=true&loc=Local
LOG_SQL_DSN=
SQL_MAX_IDLE_CONNS=10
SQL_MAX_OPEN_CONNS=100
SQL_MAX_LIFETIME=60

# Generate your own values for local and production.
SESSION_SECRET=change_me_local_session_secret
CRYPTO_SECRET=change_me_32_bytes_or_more

# Redis is optional for local source development. Leave empty for memory/local behavior.
REDIS_CONN_STRING=

# Deployment script settings. Fill in .env only.
DEPLOY_BRANCH=sdkmax-prod
DEPLOY_REMOTE=deploy
DEPLOY_REMOTE_NAME_ON_SERVER=origin
DEPLOY_HEALTH_URL=https://api.sdkmax.com/api/status
DEPLOY_SSH_HOST=your-server-host
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22
DEPLOY_REMOTE_APP_DIR=/www/wwwroot/new-api
DEPLOY_REMOTE_DATA_DIR=/www/wwwroot/new-api/data
DEPLOY_REMOTE_BACKUP_DIR=/www/backup/sdkmax
DEPLOY_COMPOSE_FILE=docker-compose.prod.yml
DEPLOY_COMPOSE_SERVICE=new-api
DEPLOY_HEALTH_TIMEOUT_SECONDS=90
DEPLOY_HEALTH_INTERVAL_SECONDS=3

# Remote database backup command. Keep secrets in the remote server env or .env.
# SDKMAX production uses BT-managed native MySQL on the host, not a MySQL
# container. Keep real credentials in .env only.
# DEPLOY_REMOTE_DB_BACKUP_CMD=mysqldump -u<user> -p'<password>' sdkmax_new_api
DEPLOY_REMOTE_DB_BACKUP_CMD=
